---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/writing";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(
  post.data.date,
);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="section">
    <header class="post-head">
      <time class="label" datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
      <h1 class="page-title">{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
